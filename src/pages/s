  { id: '1', name: 'Ideapad' },
  { id: '2', name: 'Lexus' },
  { id: '3', name: 'Vostro' }
];

const series: Item[] = [
  { id: '1', name: '3000' },
  { id: '2', name: '2832' },
  { id: '3', name: '9343' }
];

// Relación entre marcas, modelos y series
const relaciones: Record<string, Record<string, { modelos: string[], series: string[] }>> = {
  Computadora: {
    Lenovo: { modelos: ['Ideapad'], series: ['3000', '2832'] },
    Dell: { modelos: ['Lexus'], series: ['2832'] },
    Asus: { modelos: ['Ideapad'], series: ['3000'] },
    HP: { modelos: ['Lexus'], series: ['2832'] }
  },
  Laptop: {
    Asus: { modelos: ['Ideapad', 'Lexus'], series: ['9343', '3000'] },
    HP: { modelos: ['Lexus'], series: ['3000', '2832'] },
    Dell: { modelos: ['Lexus'], series: ['9343'] }
  }
};

const Activos = () => {
  const [periferico, setPeriferico] = useState<string | null>(null);
  const [marca, setMarca] = useState<string | null>(null);
  const [modelo, setModelo] = useState<string | null>(null);
  const [serie, setSerie] = useState<string | null>(null);
  const [selectedItems, setSelectedItems] = useState<string[]>([]);

  const marcasFiltradas = periferico ? Object.keys(relaciones[periferico] || {}) : [];
  const modelosFiltrados = periferico && marca ? relaciones[periferico][marca]?.modelos : [];
  const seriesFiltradas = periferico && marca ? relaciones[periferico][marca]?.series : [];

  useEffect(() => {
    if (modelo && !modelosFiltrados?.includes(modelo)) {
      setModelo(null);
    }
    if (serie && !seriesFiltradas?.includes(serie)) {
      setSerie(null);
    }
  }, [marca, modelosFiltrados, seriesFiltradas]);

  const handleCheckboxChange = (id: string) => {
    setSelectedItems((prev) =>
      prev.includes(id) ? prev.filter((item) => item !== id) : [...prev, id]
    );
  };

  const handleSelectAllChange = (event: React.ChangeEvent<HTMLInputElement>) => {
    setSelectedItems(event.target.checked ? equipos.map((item) => item.id) : []);
  };

  return (
    <div className="flex flex-col p-4">
      <div className="mb-4">
        <h1 className="text-2xl font-bold my-5">Consulta de Activos</h1>
        <div className="flex flex-wrap gap-4 my-10">
          <Autocomplete
            size="small"
            disablePortal
            options={perifericos}
            getOptionLabel={(option) => option.name}
            onChange={(event, newValue) => setPeriferico(newValue?.name || null)}
            renderInput={(params) => (
              <TextField {...params} label="Periférico" variant="outlined" />
            )}
            className="w-full md:w-1/6"
          />
          <Autocomplete
            size="small"
            disablePortal
            options={marcas.filter(m => marcasFiltradas.includes(m.name))}
            getOptionLabel={(option) => option.name}
            onChange={(event, newValue) => setMarca(newValue?.name || null)}
            renderInput={(params) => (
              <TextField {...params} label="Marca" variant="outlined" />
            )}
            className="w-full md:w-1/6"
          />
          <Autocomplete
            size="small"
            disablePortal
            options={modelos.filter(m => modelosFiltrados?.includes(m.name) || false)}
            getOptionLabel={(option) => option.name}
            onChange={(event, newValue) => setModelo(newValue?.name || null)}
            renderInput={(params) => (
              <TextField {...params} label="Modelo" variant="outlined" />
            )}
            className="w-full md:w-1/6"
          />
          <Autocomplete
            size="small"
            disablePortal
            options={series.filter(s => seriesFiltradas?.includes(s.name) || false)}
            getOptionLabel={(option) => option.name}
            onChange={(event, newValue) => setSerie(newValue?.name || null)}
            renderInput={(params) => (
              <TextField {...params} label="Serie" variant="outlined" />
            )}
            className="w-full md:w-1/6"
          />
          <div className="flex flex-col md:flex-row gap-4 w-full md:w-1/2">
            <input
              type="text"
              placeholder="Buscar..."
              className="w-full md:w-1/2 p-2 border border-gray-300 rounded"
            />
            <button className="bg-blue-600 hover:bg-blue-700 text-white p-2 rounded w-full md:w-1/2">
              Agregar
            </button>
          </div>
        </div>
      </div>

      <div className="mb-4">
        <table className="w-full text-sm text-left text-gray-500">
          <thead className="text-xs text-gray-700 uppercase bg-gray-50">
            <tr>
              <th scope="col" className="px-4 py-4">
                <input
                  type="checkbox"
                  onChange={handleSelectAllChange}
                />
              </th>
              <th scope="col" className="px-4 py-3">Periférico</th>
              <th scope="col" className="px-4 py-3">Marca</th>
              <th scope="col" className="px-4 py-3">Modelo</th>
