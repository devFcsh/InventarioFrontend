                <td className="px-4 py-3 max-w-[12rem] truncate">{item.inventario}</td>
                <td className="px-4 py-3">{item.usuario}</td>
                <td className="px-4 py-3">{item.uso}</td>
                <td className="px-4 py-3">{item.ubicacion}</td>
